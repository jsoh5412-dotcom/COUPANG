# 복사해서 .env 로 만들고 값을 채운다. .env 는 커밋하지 않는다.

# 필수: 실사 이미지 생성
OPENAI_API_KEY=

# 선택: 이미지 생성 보조
GEMINI_API_KEY=

# 선택: 누끼 품질이 중요할 때 (없으면 로컬 rembg 사용)
PHOTOROOM_API_KEY=

# 선택: 도매꾹·도매매 상품 정보 수집
DOMEGGOOK_API_KEY=

# 맥북에 동기화된 Google Drive 쿠팡 폴더 경로 (Google Drive 데스크톱 앱 설치 후)
# 예: /Users/<이름>/Library/CloudStorage/GoogleDrive-<계정>/내 드라이브/<쿠팡 폴더>
COUPANG_DRIVE_DIR=

# 시장조사 팀 시즌 트랙: 네이버 데이터랩 검색어 트렌드·쇼핑인사이트 API
# 2026-09부터 developers.naver.com이 아니라 네이버 클라우드 플랫폼 NAVER API HUB에서 발급한다.
# 콘솔 → NAVER API HUB → Application 등록 → 검색어 트렌드·쇼핑인사이트 선택 → API 관리 → 인증 정보.
# 호출: https://naverapihub.apigw.ntruss.com, 헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 디스코드 보고방 (결정 40). 채널별 웹후크 주소. 서버 설정 → 연동 → 웹후크에서 만든다.
DISCORD_WEBHOOK_PM=
DISCORD_WEBHOOK_PLANNING=
DISCORD_WEBHOOK_PDP=
DISCORD_WEBHOOK_RESEARCH=
DISCORD_WEBHOOK_LISTING=
DISCORD_WEBHOOK_LOGISTICS=
DISCORD_WEBHOOK_ADS=
DISCORD_WEBHOOK_ALERT=
# 막힘 알림에서 사용자를 @멘션할 때 쓰는 사용자 ID (숫자)
DISCORD_USER_ID=

# 구글 시트 읽기·쓰기 (결정 46). 구글 클라우드 서비스 계정 키(JSON) 파일의 맥북 경로. 키 파일은 저장소 밖에 둔다.
# 예: /Users/<이름>/.secrets/coupang-sheets.json
GOOGLE_SERVICE_ACCOUNT_JSON=
