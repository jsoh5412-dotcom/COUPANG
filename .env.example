# 복사해서 .env 로 만들고 값을 채운다. .env 는 커밋하지 않는다.

# 필수: 실사 이미지 생성
OPENAI_API_KEY=

# 선택: 이미지 생성 보조
GEMINI_API_KEY=

# 선택: 누끼 품질이 중요할 때 (없으면 로컬 rembg 사용)
PHOTOROOM_API_KEY=

# 선택: 도매꾹·도매매 상품 정보 수집
DOMEGGOOK_API_KEY=

# 맥북에 동기화된 Google Drive 쿠팡 폴더 경로 (Google Drive 데스크톱 앱 설치 후)
# 예: /Users/<이름>/Library/CloudStorage/GoogleDrive-<계정>/내 드라이브/<쿠팡 폴더>
COUPANG_DRIVE_DIR=

# 시장조사 팀 시즌 트랙: 네이버 데이터랩 검색어 트렌드 API (developers.naver.com 애플리케이션 등록)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 디스코드 보고방 (결정 40). 채널별 웹후크 주소. 서버 설정 → 연동 → 웹후크에서 만든다.
DISCORD_WEBHOOK_PM=
DISCORD_WEBHOOK_PLANNING=
DISCORD_WEBHOOK_PDP=
DISCORD_WEBHOOK_RESEARCH=
DISCORD_WEBHOOK_LISTING=
DISCORD_WEBHOOK_LOGISTICS=
DISCORD_WEBHOOK_ADS=
DISCORD_WEBHOOK_ALERT=
# 막힘 알림에서 사용자를 @멘션할 때 쓰는 사용자 ID (숫자)
DISCORD_USER_ID=
